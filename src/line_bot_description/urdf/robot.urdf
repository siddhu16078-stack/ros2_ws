<?xml version="1.0"?>
<robot name="line_bot">

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.14 0.14 0.03"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.14 0.14 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.000854" iyy="0.000854" izz="0.001633"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

   <!-- LEFT WHEEL -->
  <link name="left_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.015"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.015"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="1.5708 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00000875" iyy="0.00000875" izz="0.0000156"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.08 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- RIGHT WHEEL -->
  <link name="right_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.015"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.015"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="1.5708 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00000875" iyy="0.00000875" izz="0.0000156"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.08 0"/>
    <axis xyz="0 1 0"/>
  </joint>
    <!-- CASTER BALL -->
  <link name="caster">
    <visual>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
      <material name="grey">
        <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0000004" iyy="0.0000004" izz="0.0000004"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="0.055 0 -0.015"/>
  </joint>

  <gazebo reference="caster">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- CAMERA MOUNT -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.01 0.03 0.02"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0.1 0.1 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.000003" iyy="0.000001" izz="0.000003"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.065 0 0.03" rpy="0 0.8 0"/>
  </joint>
    <!-- DIFF DRIVE PLUGIN -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.16</wheel_separation>
      <wheel_radius>0.025</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publisher_frequency>30</odom_publisher_frequency>
    </plugin>
  </gazebo>
  
  <gazebo reference="camera_link">
  <sensor name="line_camera" type="camera">
    <always_on>true</always_on>
    <update_rate>30</update_rate>
    <topic>camera/image_raw</topic>
    <camera>
      <horizontal_fov>1.2</horizontal_fov>
      <image><width>320</width><height>240</height><format>R8G8B8</format></image>
      <clip><near>0.02</near><far>5</far></clip>
    </camera>
  </sensor>
</gazebo>

<link name="caster_rear">
  <visual><geometry><sphere radius="0.01"/></geometry></visual>
  <collision><geometry><sphere radius="0.01"/></geometry></collision>
  <inertial>
    <mass value="0.01"/>
    <inertia ixx="0.0000004" iyy="0.0000004" izz="0.0000004" ixy="0" ixz="0" iyz="0"/>
  </inertial>
</link>
<joint name="caster_rear_joint" type="fixed">
  <parent link="base_link"/>
  <child link="caster_rear"/>
  <origin xyz="-0.055 0 -0.015"/>
</joint>
<gazebo reference="caster_rear">
  <mu1>0.0</mu1>
  <mu2>0.0</mu2>
</gazebo>

</robot>